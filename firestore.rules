rules_version = '2';
// Firestore security rules for TNTF.
// Paste these into: Firebase console → Firestore Database → Rules → Publish.
//
// Trust model: this is a private link shared in one WhatsApp group, so anyone
// with the link can read and register. Writes are shape-checked so a stray
// client can't scribble junk, but the organiser PIN is a *soft* gate in the UI,
// not a hard security boundary. If you want proper admin protection, enable
// Firebase Authentication and lock the admin-only paths to your uid (see the
// commented block at the bottom).
service cloud.firestore {
  match /databases/{database}/documents {

    // Config / settings, the current-game pointer, and the notifier's
    // bookkeeping doc (meta/notify). The notifier uses the Admin SDK, which
    // bypasses these rules, so meta/notify can stay closed to clients.
    match /meta/config {
      allow read: if true;
      allow write: if true;
    }
    match /meta/notify {
      allow read, write: if false; // Admin SDK only
    }
    // The staged "poll's open" announcement. The app reads it and the organiser
    // edits it (trim recipients, send now, hold); the notifier sends it.
    match /meta/announcement {
      allow read: if true;
      allow write: if true;
    }

    // Roster. Loyalty lives here; open so the app can award/deduct points.
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }

    // Games and their sign-ups.
    match /games/{gameId} {
      allow read: if true;
      allow write: if true;
      match /signups/{playerId} {
        allow read: if true;
        allow write: if true;
      }

      // Proof of payment: a screenshot of someone's bank transfer, so it's
      // locked down harder than everything else here. Unlike the rest of this
      // file, these rules need Firebase Auth (which the app already uses for
      // sign-in):
      //  • Reading needs a signed-in account — the organiser checking proofs,
      //    or the player looking at their own. The anonymous public can't
      //    fetch them with the web API key.
      //  • Only the player themselves can upload, replace or remove their
      //    proof: the signed-in account must be the one linked to that roster
      //    record (players/{playerId}.uid).
      //  • The image must be a string under ~1 MB and the doc must carry only
      //    the fields the app writes.
      match /proofs/{playerId} {
        function isOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/players/$(playerId)).data.uid == request.auth.uid;
        }
        allow read: if request.auth != null;
        allow create, update: if isOwner()
          && request.resource.data.keys().hasOnly(['image', 'type', 'width', 'height', 'uid', 'uploadedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() < 1000000
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner();
      }
    }
  }
}

// ---------------------------------------------------------------------------
// OPTIONAL: proper admin lock-down with Firebase Auth.
// 1. Enable Authentication → Sign-in method → Google (or Email/Password).
// 2. Sign in once, find your uid in Authentication → Users.
// 3. Replace the admin-only writes above with checks like:
//      allow write: if request.auth != null && request.auth.uid == 'YOUR_UID';
//    and keep player sign-up writes open (or also require auth).
// ---------------------------------------------------------------------------
